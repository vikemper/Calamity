cmd-calamityworldsave-desc = Saves the current Calamity world state.
cmd-calamityworldsave-help = Usage: {$command} [save | list | restore <epoch> | cancel-restore]
cmd-calamityworldsave-queued = A world save has been queued.
cmd-calamityworldsave-unavailable = A world save cannot be queued right now.
cmd-calamityworldsave-invalid-arguments = Invalid arguments. Usage: calamityworldsave [save | list | restore <epoch> | cancel-restore].
cmd-calamityworldsave-list-empty = No world backups are available.
cmd-calamityworldsave-list-header = Available world snapshot epochs:
cmd-calamityworldsave-restore-queued = Snapshot selected. Restart the server to restore that state.
cmd-calamityworldsave-restore-unavailable = Could not select that snapshot; only complete snapshots with database rollback data can be restored.
cmd-calamityworldsave-restore-cancelled = Scheduled restore cancelled.
cmd-calamityworldsave-restore-not-pending = No restore is currently scheduled.
calamity-world-save-button = Save World

calamity-persistent-round-protected = Round restarts are disabled while persistent world mode is active.

calamity-world-save-starting = The server is saving the world. A brief pause may occur.
calamity-world-save-complete = World save completed.
calamity-world-save-failed = World save failed. The previous complete save is still available.
